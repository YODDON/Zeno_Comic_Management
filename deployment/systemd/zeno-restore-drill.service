[Unit]
Description=Comic Management isolated PostgreSQL restore drill
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/zeno-comic-management
Environment=DEPLOYMENT_ROOT=/opt/zeno-comic-management
ExecStart=/bin/sh /opt/zeno-comic-management/deployment/scripts/run-restore-drill-job.sh
