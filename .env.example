# Copy to .env outside version control and replace every CHANGE_ME value.
APP_ADDRESS=http://localhost
HTTP_PORT=80
HTTPS_PORT=443
COMPOSE_SUBNET=172.30.0.0/24
ASPNETCORE_ENVIRONMENT=Production
IMAGE_REGISTRY=ghcr.io/CHANGE_ME_ORGANIZATION/zeno-comic-management
# Immutable release identifier, normally the full Git commit SHA. Never use latest.
IMAGE_TAG=CHANGE_ME_RELEASE_SHA

POSTGRES_DB=comic_management
POSTGRES_USER=comic_management
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD

GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGE_ME
AUTH_SESSION_LIFETIME=08:00:00
DATA_PROTECTION_CERTIFICATE_FILE=./secrets/data-protection.pfx
DATA_PROTECTION_CERTIFICATE_PASSWORD=CHANGE_ME
ERROR_DOCUMENTATION_BASE_URI=https://example.com/docs/errors/
LOGIN_RATE_LIMIT_PERMIT_LIMIT=10
LOGIN_RATE_LIMIT_WINDOW=00:01:00

CLOUDINARY_CLOUD_NAME=CHANGE_ME
CLOUDINARY_API_KEY=CHANGE_ME
CLOUDINARY_API_SECRET=CHANGE_ME
CLOUDINARY_CHAPTER_PAGE_PREFIX=comic-management/chapter-pages
CLOUDINARY_MAXIMUM_CHAPTER_PAGE_BYTES=10485760

REFUND_FINGERPRINT_VERSION=v1
# Base64 encoding of at least 32 cryptographically random bytes.
REFUND_FINGERPRINT_KEY_V1=CHANGE_ME
REFUND_PROTECTION_VERSION=v1

TOPUP_ORDER_TTL_MINUTES=30
VIP_ORDER_TTL_MINUTES=30

# Keep disabled until project-owned SePay Test-mode verification is accepted.
SEPAY_WEBHOOK_ENABLED=false
SEPAY_WEBHOOK_SECRET=
SEPAY_EXPECTED_ACCOUNT_NUMBER=
SEPAY_TIMESTAMP_TOLERANCE_SECONDS=300
SEPAY_MAXIMUM_BODY_BYTES=65536
SEPAY_PERMIT_LIMIT_PER_MINUTE=120

BACKUP_DIRECTORY=./backups
# Public age recipient used for backup encryption. The private identity remains a mounted secret.
BACKUP_AGE_RECIPIENT=CHANGE_ME_AGE_RECIPIENT
BACKUP_AGE_IDENTITY_FILE=./secrets/backup-age.key
# Set to an encrypted filename under BACKUP_DIRECTORY for a restore drill.
BACKUP_FILE=
# Required for the isolated restore drill; it cannot relax the target allowlist.
RESTORE_DESTRUCTIVE_CONFIRMATION=
